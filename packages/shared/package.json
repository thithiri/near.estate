{
  "name": "@estate/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc --watch -p tsconfig.json --preserveWatchOutput",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test src/*.test.ts",
    "seed:check": "tsx src/check-seed.ts"
  },
  "dependencies": {
    "zod": "4.6.7"
  }
}
