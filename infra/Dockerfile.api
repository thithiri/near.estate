FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json tsconfig.base.json ./
COPY patches ./patches
COPY packages/shared/package.json ./packages/shared/package.json
COPY services/api/package.json ./services/api/package.json
COPY services/worker/package.json ./services/worker/package.json
COPY apps/web/package.json ./apps/web/package.json
RUN npm ci
COPY packages/shared ./packages/shared
COPY services/api ./services/api
COPY services/worker ./services/worker
COPY apps/web ./apps/web
COPY contracts/estate/seed.json ./contracts/estate/seed.json
COPY contracts/estate/seed-v2.json ./contracts/estate/seed-v2.json
COPY contracts/estate/migration-v1-to-v2-draft.json ./contracts/estate/migration-v1-to-v2-draft.json
RUN npm run build -w @estate/shared && npm run build -w @estate/api

FROM node:22-alpine AS runtime-deps
WORKDIR /app
COPY package.json package-lock.json ./
COPY packages/shared/package.json ./packages/shared/package.json
COPY services/api/package.json ./services/api/package.json
COPY services/worker/package.json ./services/worker/package.json
COPY apps/web/package.json ./apps/web/package.json
RUN npm pkg delete scripts.postinstall && npm ci --omit=dev --workspace @estate/api --workspace @estate/shared --include-workspace-root=false

FROM node:22-alpine
ARG ESTATE_SOURCE_REVISION=unknown
LABEL org.opencontainers.image.revision=${ESTATE_SOURCE_REVISION}
WORKDIR /app
COPY --from=runtime-deps /app/node_modules ./node_modules
COPY --from=build /app/packages/shared/package.json ./packages/shared/package.json
COPY --from=build /app/packages/shared/dist ./packages/shared/dist
COPY --from=build /app/services/api/package.json ./services/api/package.json
COPY --from=build /app/services/api/dist ./services/api/dist
COPY --from=build /app/contracts/estate/seed.json ./contracts/estate/seed.json
COPY --from=build /app/contracts/estate/seed-v2.json ./contracts/estate/seed-v2.json
COPY --from=build /app/contracts/estate/migration-v1-to-v2-draft.json ./contracts/estate/migration-v1-to-v2-draft.json
COPY --from=build /app/apps/web/src/preset-catalog.json ./apps/web/src/preset-catalog.json
COPY --from=build /app/apps/web/src/guest-illustrations.json ./apps/web/src/guest-illustrations.json
COPY --from=build /app/apps/web/public/presets ./apps/web/public/presets
COPY --from=build /app/apps/web/public/guest-buildings ./apps/web/public/guest-buildings
RUN mkdir -p /data /status && chown node:node /data /status
USER node
ENV PORT=3000
ENV API_DATA_DIR=/data
EXPOSE 3000
CMD ["node", "services/api/dist/index.js"]
