FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json tsconfig.base.json ./
COPY patches ./patches
COPY packages/shared ./packages/shared
COPY apps/web ./apps/web
COPY services/api ./services/api
COPY services/worker ./services/worker
COPY contracts/estate/seed.json ./contracts/estate/seed.json
ARG VITE_ESTATE_CONTRACT_ID=""
ENV VITE_ESTATE_CONTRACT_ID=${VITE_ESTATE_CONTRACT_ID}
RUN npm ci && npm run build -w @estate/shared && npm run build -w @estate/web

FROM caddy:2-alpine
COPY infra/Caddyfile.dev /etc/caddy/Caddyfile
COPY --from=build /app/apps/web/dist /srv
