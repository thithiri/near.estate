:8080 {
	header {
		X-Content-Type-Options nosniff
	}
	handle_path /api/* {
		reverse_proxy api:3000
	}
	handle {
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' data: https: wss:; frame-src https:; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
