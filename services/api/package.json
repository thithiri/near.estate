{
  "name": "@estate/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "APP_ORIGIN=${APP_ORIGIN:-http://localhost:5173} tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test src/*.test.ts",
    "start": "node dist/index.js",
    "patrol:once": "node dist/run-inspector.js --once",
    "patrol:start": "node dist/run-inspector.js --run",
    "paid:reconcile": "node dist/reconcile-uncertain.js"
  },
  "dependencies": {
    "@estate/shared": "0.1.0",
    "@hono/node-server": "2.1.6",
    "@near-js/accounts": "2.3.0",
    "@near-js/providers": "2.3.0",
    "@near-js/signers": "2.3.0",
    "@near-wallet-selector/core": "10.1.4",
    "hono": "4.13.17",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@near-js/crypto": "2.3.0"
  }
}
